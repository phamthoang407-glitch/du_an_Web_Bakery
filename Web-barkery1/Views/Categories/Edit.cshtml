@model Category
@{ ViewData["Title"] = "Sửa danh mục"; }
<h1>Sửa danh mục</h1><form asp-action="Edit" asp-route-id="@Model.Id" method="post" class="panel form-panel"><input asp-for="Id" type="hidden" /><label asp-for="Name">Tên danh mục</label><input asp-for="Name" class="form-control my-2" /><span asp-validation-for="Name" class="text-danger d-block"></span><button type="submit" class="btn btn-primary mt-3">Lưu</button> <a asp-action="Index">Quay lại</a></form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
