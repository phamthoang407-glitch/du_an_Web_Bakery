@model List<NewsArticle>
@{ ViewData["Title"] = "Tin tức"; }
<h1>Tin từ quầy bánh</h1>
@if (User.IsInRole("ADMIN")) { <a class="btn btn-primary mb-3" asp-action="Manage">Quản lý tin tức</a> }
@if (Model.Count == 0) { <p>Chưa có tin tức được đăng.</p> }
<div class="dashboard-grid">@foreach (var n in Model) { <article class="panel"><small class="text-muted">@n.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy")</small><h2 class="h4 my-3">@n.Title</h2><a asp-action="Details" asp-route-id="@n.Id">Đọc bài viết →</a></article> }</div>
