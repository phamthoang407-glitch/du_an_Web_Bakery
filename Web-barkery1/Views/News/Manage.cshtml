@model List<NewsArticle>
@{ ViewData["Title"] = "Quản lý tin tức"; }
<h1>Quản lý tin tức</h1><a class="btn btn-primary mb-3" asp-action="Edit">Viết tin mới</a><div class="table-responsive"><table class="table mb-0"><thead><tr><th>Tiêu đề</th><th>Trạng thái</th><th>Thao tác</th></tr></thead><tbody>
@foreach (var n in Model) { <tr><td>@n.Title</td><td>@(n.IsPublished ? "Đã đăng" : "Bản nháp")</td><td><a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@n.Id">Sửa</a> <form class="d-inline" asp-action="Delete" asp-route-id="@n.Id" method="post" data-confirm="Xóa bài viết này?"><button class="btn btn-sm btn-outline-danger" type="submit">Xóa</button></form></td></tr> }
</tbody></table></div>
