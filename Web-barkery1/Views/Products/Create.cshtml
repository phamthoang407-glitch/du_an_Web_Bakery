@model ProductCreateViewModel
@{ ViewData["Title"] = "Thêm bánh"; }
<h1>Thêm bánh</h1>
@if (Model.Categories.Count == 0) { <p>Tạo danh mục trước khi thêm bánh.</p><a asp-controller="Categories" asp-action="Create">Thêm danh mục</a> }
else { <form asp-action="Create" method="post" class="panel form-panel"><partial name="_ProductForm" model="Model" /><p class="text-muted">Số lượng ban đầu bằng 0. Sử dụng Nhập để bổ sung bánh bán trong ngày.</p><button class="btn btn-primary" type="submit">Lưu bánh</button> <a asp-action="Index" class="btn btn-light">Quay lại</a></form> }
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
