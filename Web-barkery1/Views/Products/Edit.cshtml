@model ProductEditViewModel
@{ ViewData["Title"] = "Sửa thông tin bánh"; }
<h1>Sửa thông tin bánh</h1>
<form asp-action="Edit" asp-route-id="@Model.Id" method="post" class="panel form-panel"><input asp-for="Id" type="hidden" /><partial name="_ProductForm" model="Model" /><button type="submit" class="btn btn-primary">Lưu thay đổi</button> <a asp-action="Index" class="btn btn-light">Quay lại</a></form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
