@model ProductCreateViewModel
<div asp-validation-summary="ModelOnly" class="text-danger"></div>
<div class="mb-3"><label asp-for="Name" class="form-label">Tên bánh</label><input asp-for="Name" class="form-control" maxlength="150" /><span asp-validation-for="Name" class="text-danger"></span></div>
<div class="mb-3"><label asp-for="CategoryId" class="form-label">Danh mục</label><select asp-for="CategoryId" asp-items="Model.Categories" class="form-select"><option value="">-- Chọn danh mục --</option></select><span asp-validation-for="CategoryId" class="text-danger"></span></div>
<div class="mb-3"><label asp-for="Price" class="form-label">Giá bán (đồng)</label><input asp-for="Price" type="number" step="1" min="1" class="form-control" /><span asp-validation-for="Price" class="text-danger"></span><div class="form-text">Nhập 150000 cho giá 150.000 đồng.</div></div>
<div class="mb-3"><label asp-for="ImageUrl" class="form-label">Đường dẫn ảnh (không bắt buộc)</label><input asp-for="ImageUrl" class="form-control" placeholder="/images/banh.jpg hoặc https://..." /><span asp-validation-for="ImageUrl" class="text-danger"></span><div class="form-text">Đặt ảnh trong wwwroot/images rồi nhập /images/tên-file.</div></div>
<div class="mb-3"><label asp-for="Description" class="form-label">Mô tả</label><textarea asp-for="Description" rows="4" class="form-control" maxlength="2000"></textarea><span asp-validation-for="Description" class="text-danger"></span></div>
