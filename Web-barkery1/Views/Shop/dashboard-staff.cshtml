@using Microsoft.AspNetCore.Antiforgery
@using Microsoft.AspNetCore.Identity
@using Web_barkery1.Models
@inject IAntiforgery Csrf
@inject UserManager<ApplicationUser> Users
@{
 Layout = null;
 var account = await Users.GetUserAsync(User);
 var role = User.IsInRole("ADMIN") ? "ADMIN" : User.IsInRole("STAFF") ? "STAFF" : "CUSTOMER";
 var current = account == null ? null : new { id=account.Id, full_name=account.FullName, email=account.Email, role=role };
}
<!doctype html>
<html lang="vi">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Nhân viên | Bakery Shop</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="../css/style.css" />
    <link rel="stylesheet" href="../css/header.css" />
    <link rel="stylesheet" href="../css/dashboard-pro.css" />
    <link rel="stylesheet" href="../css/dashboard-polish.css" />
    <link rel="stylesheet" href="../css/responsive.css" />
  <meta name="csrf-token" content="@Csrf.GetAndStoreTokens(Context).RequestToken" />
<script>window.BAKERY_USER = @Json.Serialize(current);</script>
</head>
  <body class="admin-body staff-dashboard">
    <div class="admin-shell">
      <aside class="admin-sidebar">
        <a class="admin-brand" href="../index.html"
          ><img class="brand__logo" src="../images/bakery-logo.svg" alt="Logo Bakery" width="45" height="45"
          ><span><b>BAKERY</b><small>STAFF PORTAL</small></span></a
        >
        <div class="admin-user">
          <div class="admin-avatar staff">NV</div>
          <div><b>Tài khoản quầy</b><small>Nhân viên quầy</small></div>
        </div>
        <nav>
          <a class="active" href="dashboard-staff.html"
            >▦ <span>Đơn hàng</span></a
          ><a href="#orders">▤ <span>Danh sách đơn</span></a>
        </nav>
        <div class="admin-side-bottom">
          <a href="../index.html">← Về website</a
          ><a href="login.html">⇥ Đăng xuất</a>
        </div>
      </aside>
      <main class="admin-main">
        <header class="admin-top">
          <div>
            <span class="eyebrow">STAFF PORTAL</span>
            <h1>Khu vực nhân viên</h1>
            <p>Tiếp nhận và cập nhật trạng thái đơn hàng.</p>
          </div>
          <div class="top-avatar staff">MA</div>
        </header>
        <section class="stat-grid staff-stats">
          <div class="admin-stat">
            <div class="stat-icon">⏳</div>
            <small>CHỜ XÁC NHẬN</small><strong>—</strong
            ><span class="neutral">Cần xử lý ngay</span>
          </div>
          <div class="admin-stat">
            <div class="stat-icon">◫</div>
            <small>ĐANG CHUẨN BỊ</small><strong>—</strong
            ><span class="up">Trong danh sách đơn</span>
          </div>
          <div class="admin-stat">
            <div class="stat-icon">✓</div>
            <small>ĐÃ HOÀN THÀNH</small><strong>—</strong
            ><span class="up">Trong danh sách đơn</span>
          </div>
        </section>
        <section class="admin-card table-card" id="orders">
          <div class="expiry-panel"><div class="card-head"><div><b>⚠ Cảnh báo hạn sử dụng bánh</b><small>Thông báo dành cho nhân viên; chỉ chủ quầy có quyền nhập/xuất và sửa hạn</small></div></div><div id="staff-expiry-alerts" aria-live="polite">Đang kiểm tra...</div></div>
          <div class="card-head">
            <div>
              <b>Danh sách đơn hàng</b
              ><small>Ưu tiên đơn đang chờ xác nhận</small>
            </div>
            <div class="filter-pills">
              <button class="active">Tất cả</button><button>Chờ xác nhận</button
              ><button>Đang chuẩn bị</button>
            </div>
          </div>
          <div class="table-scroll">
            <table class="admin-table">
              <thead>
                <tr>
                  <th>Mã đơn</th>
                  <th>Khách hàng</th>
                  <th>Sản phẩm</th>
                  <th>Tổng tiền</th>
                  <th>Trạng thái</th>
                  <th>Thao tác</th>
                </tr>
              </thead>
              <tbody>
                <tr>
                  <td colspan="6">Đang tải đơn hàng…</td>
                </tr>
              </tbody>
            </table>
          </div>
        </section>
      </main>
    </div>
    <script src="../js/api.js"></script>
    <script src="../js/data.js"></script>
    <script src="/js/site-branding.js?v=20261116-5"></script><script src="../js/main.js"></script>
    <script src="../js/dashboard-pro.js"></script>
    <script src="../js/dashboard-polish.js"></script>
    <script>
      document.addEventListener("DOMContentLoaded", () => requireRole("STAFF", "ADMIN"));
    </script>
  </body>
</html>
