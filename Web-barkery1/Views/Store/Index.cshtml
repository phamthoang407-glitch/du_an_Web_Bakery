@model StoreInfo
@{ ViewData["Title"] = "Vị trí quầy"; }
<p class="eyebrow">Một quầy · Gần gũi mỗi ngày</p><h1>Ghé quầy bánh</h1><section class="panel form-panel"><h2 class="h4">@Model.Name</h2><p class="mt-3"><strong>Địa chỉ:</strong> @Model.Address</p>
@if (!string.IsNullOrWhiteSpace(Model.Phone)) { <p><strong>Liên hệ:</strong> @Model.Phone</p> }
@if (!string.IsNullOrWhiteSpace(Model.OpeningHours)) { <p><strong>Giờ mở cửa:</strong> @Model.OpeningHours</p> }
<a class="btn btn-primary" href="https://www.google.com/maps/search/?api=1&amp;query=@(Uri.EscapeDataString(Model.Address))" target="_blank" rel="noopener noreferrer">Tìm đường trên Google Maps</a>
@if (User.IsInRole("ADMIN")) { <a class="btn btn-light" asp-action="Edit">Sửa thông tin</a> }</section>
